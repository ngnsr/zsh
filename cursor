cursor_mode() {
    # Guard: Do not run cursor escapes on dumb terminals
    [[ "$TERM" == "dumb" ]] && return

    cursor_set_beam() {
        if [[ -n "$TMUX" ]]; then
            echo -ne "\ePtmux;\e\e[6 q\e\\"
        else
            echo -ne "\e[6 q"
        fi
    }

    cursor_set_block() {
        if [[ -n "$TMUX" ]]; then
            echo -ne "\ePtmux;\e\e[2 q\e\\"
        else
            echo -ne "\e[2 q"
        fi
    }

    cursor_keymap_select() {
        if [[ ${KEYMAP} == vicmd ]]; then
            cursor_set_block
        else
            cursor_set_beam
        fi
    }

    # Register hooks using Zsh's native hook-widget system
    autoload -Uz add-zle-hook-widget
    add-zle-hook-widget line-init cursor_set_beam
    add-zle-hook-widget line-finish cursor_set_block
    add-zle-hook-widget keymap-select cursor_keymap_select
}

cursor_mode
