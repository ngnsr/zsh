cursor_mode() {
    # Guard: Do not run cursor escapes on dumb terminals
    [[ "$TERM" == "dumb" ]] && return

    # Default escape sequences for cursor shapes:
    #   \e[1 q : blinking block      \e[2 q : steady block
    #   \e[3 q : blinking underline  \e[4 q : steady underline
    #   \e[5 q : blinking beam       \e[6 q : steady beam
    local cursor_block='\e[2 q'
    local cursor_beam='\e[6 q'

    # Wrap for Tmux if inside a session
    if [[ -n "$TMUX" ]]; then
        cursor_block="\ePtmux;\e${cursor_block}\e\\"
        cursor_beam="\ePtmux;\e${cursor_beam}\e\\"
    fi

    cursor_set_beam() {
        echo -ne "$cursor_beam"
    }

    cursor_set_block() {
        echo -ne "$cursor_block"
    }

    cursor_keymap_select() {
        if [[ ${KEYMAP} == vicmd ]]; then
            cursor_set_block
        else
            cursor_set_beam
        fi
    }

    # Register hooks using Zsh's native hook-widget system
    autoload -Uz add-zle-hook-widget
    add-zle-hook-widget line-init cursor_set_beam
    add-zle-hook-widget line-finish cursor_set_block
    add-zle-hook-widget keymap-select cursor_keymap_select
}

cursor_mode
